 "lines": [
  {
   "id": "s1",
   "text": "Das BMW-Logo ist *kein* *Propeller.*"
  },
  {
   "id": "s2",
   "text": "Auch wenn es fast jeder glaubt."
  },
  {
   "id": "s3",
   "text": "Die Propeller-Geschichte stammt aus einer Werbeanzeige von *1929.*"
  },
  {
   "id": "s4",
   "text": "Das Logo zeigt die Farben Bayerns: *Weiß* *und* *Blau.*"
  },
  {
   "id": "s5",
   "text": "Angefangen hat alles *1916.* Mit Flugmotoren."
  },
  {
   "id": "s6",
   "text": "*1923* kam das erste Motorrad."
  },
  {
   "id": "s7",
   "text": "*1928* das erste Auto."
  },
  {
   "id": "s8",
   "text": "Und seit *1933* prägt ein Detail das Gesicht der Marke: die *Niere.*"
  },
  {
   "id": "s9",
   "text": "Jetzt weißt du, was das Logo wirklich zeigt."
  }
